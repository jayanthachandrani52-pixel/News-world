    <script>
        // === Live Date & Time ===
        function updateDateTime() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short' };
            document.getElementById('liveDateTime').textContent = now.toLocaleDateString('en-US', options);
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();

        // === Breaking News Ticker ===
        const tickerEl = document.getElementById('breakingTicker');
        tickerEl.innerHTML = OmniGlobeData.breakingNews.map(item => `<span class="inline-flex items-center mx-8"><span class="w-1.5 h-1.5 bg-crimson-red rounded-full mr-3"></span>${item}</span>`).join('');

        // === Trending Now List ===
        const trendingEl = document.getElementById('trendingList');
        trendingEl.innerHTML = OmniGlobeData.trending.map(item => `
            <li class="flex items-start space-x-3 group cursor-pointer">
                <span class="text-2xl font-extrabold text-slate-200 dark:text-slate-700 group-hover:text-crimson-red transition leading-none">${item.id}</span>
                <div class="flex-1">
                    <p class="text-sm font-semibold leading-snug group-hover:text-crimson-red transition mb-1">${item.title}</p>
                    <div class="flex items-center space-x-2 text-[11px] text-slate-400">
                        <span>${item.time}</span>
                        <span>•</span>
                        <span class="flex items-center">
                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path></svg>
                            ${item.views}
                        </span>
                    </div>
                </div>
                <img src="${item.img}" alt="" class="w-12 h-12 rounded object-cover">
            </li>
        `).join('');

        // === Editor's Picks ===
        document.getElementById('editorsPicksList').innerHTML = OmniGlobeData.editorsPicks.map((item, idx) => `
