                            ${item.time}
                        </p>
                    </div>
                </article>
            `;
        }
        document.getElementById('techGrid').innerHTML = OmniGlobeData.categoryGrid.tech.map(generateCategoryCard).join('');
        document.getElementById('businessGrid').innerHTML = OmniGlobeData.categoryGrid.business.map(generateCategoryCard).join('');
        document.getElementById('worldGrid').innerHTML = OmniGlobeData.categoryGrid.world.map(generateCategoryCard).join('');

        // === Theme Toggle ===
        const themeToggle = document.getElementById('themeToggle');
